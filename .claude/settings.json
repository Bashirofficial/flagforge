{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(git branch -m main*)",
      "Bash(git branch -M main*)",
      "Bash(git reset --hard*)",
      "Bash(git * --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr create * --base main*)",
      "Bash(gh pr create * -B main*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git checkout main*)",
      "PowerShell(git switch main*)",
      "PowerShell(git branch -D main*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr create * --base main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
